{
  "title": "Search for a Patient",
  "pages": [
    {
      "name": "search_for_patient",
      "description": "Enter the patient’s last name. Date of birth and NHS number are optional filters.",
      "elements": [
        {
          "type": "text",
          "name": "last_name",
          "title": "Last Name",
          "isRequired": true,
          "autocomplete": "family-name"
        },
        {
          "type": "text",
          "name": "date_of_birth",
          "startWithNewLine": false,
          "title": "Date of Birth",
          "inputType": "date",
          "autocomplete": "bday"
        },
        {
          "type": "text",
          "name": "nhs-number",
          "startWithNewLine": false,
          "title": "NHS Number",
          "autocomplete": "bday",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "999 999 9999"
          }
        }
      ]
    }
  ],
  "checkErrorsMode": "onValueChanged",
  "completeText": "Search",
  "headerView": "advanced"
}
