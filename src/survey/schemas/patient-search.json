{
  "title": "Search for a Patient",
  "pages": [
    {
      "name": "search_for_patient",
      "description": "Enter the patient’s last name and either their date of birth or NHS number.",
      "elements": [
        {
          "type": "text",
          "name": "last_name",
          "title": "Last Name",
          "isRequired": true,
          "autocomplete": "family-name"
        },
        {
          "type": "text",
          "name": "date_of_birth",
          "startWithNewLine": false,
          "title": "Date of Birth",
          "requiredIf": "{nhs-number} empty",
          "validators": [
            {
              "type": "expression"
            }
          ],
          "inputType": "date",
          "autocomplete": "bday"
        },
        {
          "type": "text",
          "name": "nhs-number",
          "startWithNewLine": false,
          "title": "NHS Number",
          "requiredIf": "{date_of_birth} empty",
          "autocomplete": "bday",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "999 999 9999"
          }
        }
      ]
    }
  ],
  "checkErrorsMode": "onValueChanged",
  "completeText": "Search",
  "headerView": "advanced"
}
