{
  "title": "Search for a Patient",
  "description": "Results update as you type. Filter by name, date of birth, or NHS number.",
  "textUpdateMode": "onTyping",
  "pages": [
    {
      "name": "search_for_patient",
      "elements": [
        {
          "type": "text",
          "name": "patient_name",
          "title": "Patient name",
          "placeholder": "First name, last name, or both",
          "width": "33.333%",
          "minWidth": "200px",
          "autocomplete": "off"
        },
        {
          "type": "text",
          "name": "date_of_birth",
          "startWithNewLine": false,
          "title": "Date of Birth",
          "inputType": "date",
          "maxValueExpression": "today()",
          "width": "33.333%",
          "minWidth": "200px"
        },
        {
          "type": "text",
          "name": "nhs-number",
          "startWithNewLine": false,
          "title": "NHS Number",
          "placeholder": "Full or partial number",
          "width": "33.333%",
          "minWidth": "200px",
          "autocomplete": "off"
        }
      ]
    }
  ],
  "checkErrorsMode": "onComplete",
  "completeText": "Search",
  "headerView": "basic"
}
